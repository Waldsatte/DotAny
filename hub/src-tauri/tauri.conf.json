{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotAny",
  "version": "1.0.0",
  "identifier": "com.dotany.hub",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build.mjs",
    "beforeDevCommand": "node scripts/build.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' dotfont: http://dotfont.localhost",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  }
}
